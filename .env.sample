# Copy or run scripts/setup_integrations.py. Never commit .env.
# Live extraction requires explicit identity, endpoint, credentials and weights/licence URLs.
# Example MODEL_ID: nvidia/nemotron-3-super-120b-a12b
# Example MODEL_BASE_URL: https://api.tokenfactory.nebius.com/v1
APP_ENV=development
DEMO_MODE=false
ALLOW_SIGNUP=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3020,http://127.0.0.1:3020,http://localhost:3021,http://127.0.0.1:3021,http://localhost:3030,http://127.0.0.1:3030,http://localhost:3040,http://127.0.0.1:3040
POSTGRES_PASSWORD=
DATABASE_URL=
SCRAPER_SERVICE_TOKEN=
SCRAPER_HEALTH_URL=
SCRAPER_HEALTH_HOST=127.0.0.1
BACKEND_INTERNAL_URL=
TAVILY_API_KEY=
FIREHOSE_MGMT_KEY=
MAIL_PROVIDER=log
DIGEST_ENABLED=true
DIGEST_LOG_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_API_BASE=http://127.0.0.1:8000
# Digest unsubscribe links prefer this Next BFF host (falls back to PUBLIC_API_BASE).
PUBLIC_FRONTEND_BASE=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Blank defaults to PUBLIC_FRONTEND_BASE /api/v1/auth/oauth/google/callback (Next BFF cookie host).
GOOGLE_REDIRECT_URI=
# TypeSafe / Jev. Env wins; otherwise ~/.typesafe/key (0600) is used.
TYPESAFE_API_KEY=
JEV_CONFIDENCE_FLOOR=0.7
CATALOGUE_AUTO_PUBLISH_NEW=false
AGGREGATE_CREDIT_LABELS=CPD
DAILY_SCRAPE_JOB_CEILING=10
SCRAPE_TOPICS_FILE=
DAILY_SCRAPE_ENABLED=true
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
MODEL_WEIGHTS_URL=
MODEL_LICENSE_URL=
MODEL_OPEN_WEIGHT_CONFIRMED=false
MODEL_MAX_INPUT_CHARS=
MODEL_MAX_OUTPUT_TOKENS=
MODEL_PUBLISHER=
MODEL_HOST=
# Server-only forwarding key; generate separately for each deployed environment.
PROXY_IDENTITY_SECRET=
# Counts serverless extraction attempts, including explicit retries, per UTC day.
DISCOVERY_DAILY_RUN_LIMIT=10
# Enable only after a real SMTP delivery and reset-flow check.
PASSWORD_RECOVERY_ENABLED=false
SERVERLESS_DIGEST_ENABLED=false
