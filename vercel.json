{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [{"path": "/api/maintenance", "schedule": "0 20 * * *"}],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build:demo",
      "bindings": [{"type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL"}]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.vercel_app:app",
      "bindings": [{"type": "service", "service": "scraper", "format": "url", "env": "SCRAPER_SERVICE_URL"}]
    },
    "scraper": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "scraper.service:app"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": {"service": "frontend"}}]
}
